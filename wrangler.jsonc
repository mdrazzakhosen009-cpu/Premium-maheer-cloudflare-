{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "maheer-store",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  }
}
